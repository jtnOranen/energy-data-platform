          "position": {
            "height": 4,
            "width": 12,
            "x": 0,
            "y": 0
          },
          "widget": {
            "multilineTextboxSpec": {
              "lines": [
                "# How wind and weather show up in the Finnish day-ahead price\n\nDay-ahead prices for Finland (ENTSO-E), wind, consumption and production (Fingrid) and weather at four stations (FMI), every quarter-hour since 2024-01-01, updated daily. Local time (Europe/Helsinki)."
              ]
            },
            "name": "overview_guide"
          }
        },
        {
          "position": {
            "height": 4,
            "width": 3,
            "x": 0,
            "y": 4
          },
          "widget": {
            "name": "b6851f5c",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "wind_price_fit",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "AVG(`r_squared`)",
                      "name": "avg(r_squared)"
